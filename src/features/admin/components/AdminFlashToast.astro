---
import type { FlashMessage } from "@/features/admin/types";

interface Props {
  flashMessage?: FlashMessage | undefined;
}

const { flashMessage } = Astro.props;
---

{flashMessage && (
  <div class="fixed bottom-6 right-6 z-50 max-w-sm rounded-3xl border px-5 py-4 text-sm shadow-lg backdrop-blur-sm"
    style={`background:${flashMessage.tone === "success" ? "color-mix(in srgb, var(--page-accent-soft) 88%, transparent)" : "color-mix(in srgb, var(--admin-danger) 12%, transparent)"}; border-color: color-mix(in srgb, var(--page-border) 90%, transparent);`}
  >
    <p class="font-semibold">{flashMessage.title}</p>
    {flashMessage.description && <p class="mt-1 text-[color:var(--page-muted)]">{flashMessage.description}</p>}
  </div>
)}
