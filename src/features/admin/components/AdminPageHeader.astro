---
interface Props {
  description?: string;
  eyebrow?: string;
  title: string;
}

const { description, eyebrow, title } = Astro.props;
---

<header class="mb-8 max-w-3xl">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-3 font-serif text-5xl italic tracking-tight">{title}</h1>
  {description && <p class="mt-3 text-base leading-7 text-[color:var(--page-muted)]">{description}</p>}
</header>
