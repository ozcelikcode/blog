---
import AdminFieldError from "@/features/admin/components/AdminFieldError.astro";
import AdminRichTextEditor from "@/features/admin/components/AdminRichTextEditor.astro";
import AdminStatusBadge from "@/features/admin/components/AdminStatusBadge.astro";
import type { AdminPostEditorPageData } from "@/features/admin/posts/services/admin-post-service";

interface Props {
  action: string;
  mediaAssets: AdminPostEditorPageData["mediaAssets"];
  fieldErrors?: Record<string, string>;
  formError?: string;
  post: AdminPostEditorPageData["post"];
  sessionAuthor: AdminPostEditorPageData["sessionAuthor"];
  tags: AdminPostEditorPageData["tags"];
}

const { action, fieldErrors = {}, formError, mediaAssets, post, sessionAuthor, tags } = Astro.props;
---

<form action={action} class="space-y-8" method="post">
  {post.postId && <input name="postId" type="hidden" value={post.postId} />}

  <div class="grid min-w-0 gap-8 xl:grid-cols-[minmax(0,1.4fr)_22rem]">
    <div class="min-w-0 space-y-6">
      <div class="admin-panel">
        <label class="admin-label" for="title">Title</label>
        <input class="admin-input text-3xl font-serif italic" id="title" name="title" placeholder="Enter post title" value={post.title} />
        <AdminFieldError message={fieldErrors.title} />

        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <label>
            <span class="admin-label">Slug</span>
            <input class="admin-input" data-slug-input id="slug" name="slug" value={post.slug} />
            <AdminFieldError message={fieldErrors.slug} />
          </label>

          <div>
            <span class="admin-label">Author</span>
            <input name="authorId" type="hidden" value={post.authorId} />
            <div class="rounded-2xl border border-[color:var(--page-border)] px-4 py-3 text-sm">
              <p class="font-semibold">{sessionAuthor?.name ?? "Signed-in admin"}</p>
              <p class="mt-1 text-xs text-[color:var(--page-muted)]">{sessionAuthor?.email ?? "No active session user."}</p>
              <p class="mt-2 text-xs uppercase tracking-[0.16em] text-[color:var(--page-muted)]">Author selection is locked for this workflow.</p>
            </div>
            <AdminFieldError message={fieldErrors.authorId} />
          </div>
        </div>

        <label class="mt-6 block">
          <span class="admin-label">Excerpt</span>
          <textarea class="admin-textarea min-h-28" name="excerpt" placeholder="A concise summary for cards and metadata.">{post.excerpt}</textarea>
          <AdminFieldError message={fieldErrors.excerpt} />
        </label>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <label class="inline-flex items-center gap-3 text-sm">
            <input checked={post.isFeatured} class="h-4 w-4 rounded border-[color:var(--page-border)] bg-transparent" name="isFeatured" type="checkbox" />
            <span>Feature on homepage</span>
          </label>
          <label class="inline-flex items-center gap-3 text-sm">
            <input checked={post.showAuthorInMeta} class="h-4 w-4 rounded border-[color:var(--page-border)] bg-transparent" name="showAuthorInMeta" type="checkbox" />
            <span>Show author in post header</span>
          </label>
          <AdminStatusBadge status={post.status} />
        </div>
      </div>

      <div class="admin-panel">
        <div class="mb-4">
          <div>
            <p class="admin-label">Editor</p>
            <p class="text-sm text-[color:var(--page-muted)]">Write in a modern WYSIWYG editor, switch back to Markdown when needed, and keep Markdown as the stored source of truth.</p>
          </div>
        </div>

        <AdminRichTextEditor name="contentMarkdown" value={post.contentMarkdown} />
        <AdminFieldError message={fieldErrors.contentMarkdown} />
      </div>

      <div class="admin-panel">
        <h2 class="font-serif text-2xl italic">SEO</h2>

        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <label>
            <span class="admin-label">SEO Title</span>
            <input class="admin-input" name="seoTitle" value={post.seoTitle} />
            <AdminFieldError message={fieldErrors.seoTitle} />
          </label>

          <label>
            <span class="admin-label">Canonical URL</span>
            <input class="admin-input" name="canonicalUrl" value={post.canonicalUrl} />
            <AdminFieldError message={fieldErrors.canonicalUrl} />
          </label>
        </div>

        <label class="mt-6 block">
          <span class="admin-label">SEO Description</span>
          <textarea class="admin-textarea min-h-24" name="seoDescription">{post.seoDescription}</textarea>
          <AdminFieldError message={fieldErrors.seoDescription} />
        </label>

        <div class="mt-6 grid gap-4 xl:grid-cols-[minmax(0,1fr)_20rem]">
          <div class="rounded-2xl border border-[color:var(--page-border)] px-4 py-4">
            <p class="text-sm font-medium text-[color:var(--page-accent)]" data-seo-preview-title>{post.seoTitle || post.title || "Post title"}</p>
            <p class="mt-1 text-xs text-[color:var(--page-muted)]" data-seo-preview-url>{post.canonicalUrl || `/blog/${post.slug || "post-slug"}`}</p>
            <p class="mt-2 text-sm text-[color:var(--page-muted)]" data-seo-preview-description>{post.seoDescription || post.excerpt || "Search preview description."}</p>
          </div>

          <div class="overflow-hidden rounded-2xl border border-[color:var(--page-border)]">
            <img
              alt=""
              class:list={["aspect-[1.91/1] w-full object-cover", !post.coverImageUrl && "hidden"]}
              data-seo-preview-image
              src={post.coverImageUrl || undefined}
            />
            <div class="space-y-2 px-4 py-4">
              <p class="text-xs uppercase tracking-[0.16em] text-[color:var(--page-muted)]">Social preview</p>
              <p class="font-medium" data-seo-preview-card-title>{post.seoTitle || post.title || "Post title"}</p>
              <p class="text-sm text-[color:var(--page-muted)]" data-seo-preview-card-description>{post.seoDescription || post.excerpt || "Social description."}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <aside class="min-w-0 space-y-6">
      <div class="admin-panel">
        <h2 class="font-serif text-2xl italic">Publishing</h2>

        <label class="mt-6 block">
          <span class="admin-label">Status</span>
          <select class="admin-select" name="status">
            <option selected={post.status === "draft"} value="draft">Draft</option>
            <option selected={post.status === "scheduled"} value="scheduled">Scheduled</option>
            <option selected={post.status === "published"} value="published">Published</option>
          </select>
          <AdminFieldError message={fieldErrors.status} />
        </label>

        <label class="mt-6 block">
          <span class="admin-label">Publish At</span>
          <input class="admin-input" name="publishedAt" type="datetime-local" value={post.publishedAt} />
          <AdminFieldError message={fieldErrors.publishedAt} />
        </label>

        <div class="mt-6 grid gap-3">
          <button class="admin-button-primary w-full" name="intent" type="submit" value="save">Save Changes</button>
          <button class="admin-button-secondary w-full" name="intent" type="submit" value="save-draft">Save Draft</button>
          <button class="admin-button-secondary w-full" name="intent" type="submit" value="schedule">Schedule</button>
          <button class="admin-button-secondary w-full" name="intent" type="submit" value="publish-now">Publish Now</button>
          {post.postId && (
            <button class="admin-button-danger w-full" name="intent" type="submit" value="unpublish">Move Back To Draft</button>
          )}
        </div>
      </div>

      <div class="admin-panel">
        <h2 class="font-serif text-2xl italic">Presentation</h2>

        <label class="mt-6 block">
          <span class="admin-label">Cover Image URL</span>
          <input class="admin-input" data-cover-image-input name="coverImageUrl" placeholder="/uploads/media/example.webp" value={post.coverImageUrl} />
          <AdminFieldError message={fieldErrors.coverImageUrl} />
        </label>

        <div class="mt-6 space-y-4">
          <div class="flex items-center justify-between gap-4">
            <p class="admin-label !mb-0">Recent media</p>
            <a class="admin-button-secondary" href="/admin/media">Open Library</a>
          </div>

          <img
            alt=""
            class:list={[
              "aspect-[4/3] w-full rounded-2xl border border-[color:var(--page-border)] object-cover",
              !post.coverImageUrl && "hidden",
            ]}
            data-cover-image-preview
            src={post.coverImageUrl || undefined}
          />

          <div class="grid gap-3 sm:grid-cols-2">
            {mediaAssets.map((asset) => (
              <button
                class="rounded-2xl border border-[color:var(--page-border)] p-2 text-left transition-colors hover:border-[color:var(--page-accent)]"
                data-cover-image-picker={asset.publicUrl}
                type="button"
              >
                <img alt={asset.altText ?? ""} class="aspect-[4/3] w-full rounded-xl object-cover" src={asset.publicUrl} />
                <span class="mt-2 block truncate text-sm font-medium">{asset.fileName}</span>
                <span class="mt-1 block text-xs text-[color:var(--page-muted)]">{asset.altText || "Use as cover image"}</span>
              </button>
            ))}
          </div>
        </div>

        <fieldset class="mt-6">
          <legend class="admin-label">Tags</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            {tags.map((tag) => (
              <label class="flex items-center gap-3 rounded-2xl border border-[color:var(--page-border)] px-3 py-2 text-sm">
                <input checked={post.tagIds.includes(String(tag.id))} name="tagIds" type="checkbox" value={tag.id} />
                <span>{tag.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      {post.postId && (
        <div class="admin-panel border-[color:color-mix(in_srgb,var(--admin-danger)_40%,transparent)]">
          <h2 class="font-serif text-2xl italic">Danger Zone</h2>
          <p class="mt-3 text-sm text-[color:var(--page-muted)]">Delete the post and all tag relations. This cannot be undone.</p>
          <button class="admin-button-danger mt-6 w-full" name="intent" type="submit" value="delete">Delete Post</button>
        </div>
      )}
    </aside>
  </div>

  {formError && <div class="admin-panel border-[color:color-mix(in_srgb,var(--admin-danger)_40%,transparent)] text-sm text-[color:var(--admin-danger)]">{formError}</div>}
</form>

<script is:inline>
  const form = document.currentScript?.previousElementSibling;
  const titleInput = form?.querySelector("#title");
  const slugInput = form?.querySelector("[data-slug-input]");
  const coverImageInput = form?.querySelector("[data-cover-image-input]");
  const coverImagePreview = form?.querySelector("[data-cover-image-preview]");
  const excerptInput = form?.querySelector('[name="excerpt"]');
  const seoTitleInput = form?.querySelector('[name="seoTitle"]');
  const seoDescriptionInput = form?.querySelector('[name="seoDescription"]');
  const canonicalUrlInput = form?.querySelector('[name="canonicalUrl"]');
  const seoPreviewTitle = form?.querySelector("[data-seo-preview-title]");
  const seoPreviewUrl = form?.querySelector("[data-seo-preview-url]");
  const seoPreviewDescription = form?.querySelector("[data-seo-preview-description]");
  const seoPreviewImage = form?.querySelector("[data-seo-preview-image]");
  const seoPreviewCardTitle = form?.querySelector("[data-seo-preview-card-title]");
  const seoPreviewCardDescription = form?.querySelector("[data-seo-preview-card-description]");
  let formDirty = false;
  let autoSlug = !(slugInput instanceof HTMLInputElement) || slugInput.value.trim().length === 0;

  const slugify = (value) =>
    value
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[^\w\s-]/g, "")
      .trim()
      .replace(/[\s_-]+/g, "-")
      .replace(/^-+|-+$/g, "");

  titleInput?.addEventListener("input", () => {
    if (autoSlug && titleInput instanceof HTMLInputElement && slugInput instanceof HTMLInputElement) {
      slugInput.value = slugify(titleInput.value);
    }
  });

  slugInput?.addEventListener("input", () => {
    if (!(slugInput instanceof HTMLInputElement)) return;
    autoSlug = slugInput.value.trim().length === 0;
  });

  form?.addEventListener("input", () => {
    formDirty = true;
  });

  form?.addEventListener("submit", () => {
    formDirty = false;
  });

  const syncCoverImagePreview = () => {
    if (!(coverImageInput instanceof HTMLInputElement) || !(coverImagePreview instanceof HTMLImageElement)) {
      return;
    }

    const nextValue = coverImageInput.value.trim();
    if (!nextValue) {
      coverImagePreview.style.display = "none";
      coverImagePreview.removeAttribute("src");
      return;
    }

    coverImagePreview.style.display = "block";
    coverImagePreview.src = nextValue;
  };

  const syncSeoPreview = () => {
    const titleValue =
      seoTitleInput instanceof HTMLInputElement && seoTitleInput.value.trim()
        ? seoTitleInput.value.trim()
        : titleInput instanceof HTMLInputElement && titleInput.value.trim()
          ? titleInput.value.trim()
          : "Post title";
    const descriptionValue =
      seoDescriptionInput instanceof HTMLTextAreaElement && seoDescriptionInput.value.trim()
        ? seoDescriptionInput.value.trim()
        : excerptInput instanceof HTMLTextAreaElement && excerptInput.value.trim()
          ? excerptInput.value.trim()
          : "Search preview description.";
    const urlValue =
      canonicalUrlInput instanceof HTMLInputElement && canonicalUrlInput.value.trim()
        ? canonicalUrlInput.value.trim()
        : slugInput instanceof HTMLInputElement && slugInput.value.trim()
          ? `/blog/${slugInput.value.trim()}`
          : "/blog/post-slug";

    if (seoPreviewTitle instanceof HTMLElement) seoPreviewTitle.textContent = titleValue;
    if (seoPreviewCardTitle instanceof HTMLElement) seoPreviewCardTitle.textContent = titleValue;
    if (seoPreviewDescription instanceof HTMLElement) seoPreviewDescription.textContent = descriptionValue;
    if (seoPreviewCardDescription instanceof HTMLElement) seoPreviewCardDescription.textContent = descriptionValue;
    if (seoPreviewUrl instanceof HTMLElement) seoPreviewUrl.textContent = urlValue;

    if (seoPreviewImage instanceof HTMLImageElement && coverImageInput instanceof HTMLInputElement) {
      const nextValue = coverImageInput.value.trim();
      if (!nextValue) {
        seoPreviewImage.style.display = "none";
        seoPreviewImage.removeAttribute("src");
      } else {
        seoPreviewImage.style.display = "block";
        seoPreviewImage.src = nextValue;
      }
    }
  };

  coverImageInput?.addEventListener("input", syncCoverImagePreview);
  form?.querySelectorAll("[data-cover-image-picker]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLElement) || !(coverImageInput instanceof HTMLInputElement)) {
        return;
      }

      coverImageInput.value = button.dataset.coverImagePicker ?? "";
      coverImageInput.dispatchEvent(new Event("input", { bubbles: true }));
      coverImageInput.focus();
    });
  });

  syncCoverImagePreview();
  form?.addEventListener("input", syncSeoPreview);
  syncSeoPreview();

  window.addEventListener("beforeunload", (event) => {
    if (!formDirty) return;
    event.preventDefault();
  });
</script>
