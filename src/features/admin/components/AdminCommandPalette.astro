---
import { getAdminCommandItems } from "@/features/admin/services/admin-command-service";

const commandItems = getAdminCommandItems();
const commandGroups = Array.from(new Set(commandItems.map((item) => item.group)));
---

<div class="hidden" data-command-root>
  <div class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm" data-command-overlay></div>
  <div class="fixed left-1/2 top-4 z-50 max-h-[calc(100vh-2rem)] w-[min(40rem,calc(100vw-2rem))] -translate-x-1/2 overflow-hidden rounded-3xl border bg-[color:var(--page-card)] p-4 shadow-lg sm:top-12" data-command-panel>
    <label class="admin-label" for="admin-command-input">Quick navigation</label>
    <input class="admin-input" data-command-input id="admin-command-input" placeholder="Type a route name" type="search" />
    <div class="mt-4 max-h-[calc(100vh-11rem)] space-y-5 overflow-y-auto pr-1" data-command-items>
      {commandGroups.map((group) => (
        <section data-command-group={group}>
          <p class="admin-label">{group}</p>
          <div class="space-y-2">
            {commandItems
              .filter((item) => item.group === group)
              .map((item) => (
                <a
                  class="admin-sidebar-link block"
                  data-command-item
                  data-command-search={`${item.label} ${item.description ?? ""} ${item.keywords}`.toLowerCase()}
                  href={item.href}
                >
                  <span class="block font-medium">{item.label}</span>
                  {item.description && <span class="mt-1 block text-xs text-[color:var(--page-muted)]">{item.description}</span>}
                </a>
              ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  const commandRoot = document.querySelector("[data-command-root]");
  const commandOverlay = document.querySelector("[data-command-overlay]");
  const commandInput = document.querySelector("[data-command-input]");
  const commandItems = [...document.querySelectorAll("[data-command-item]")];
  const commandGroups = [...document.querySelectorAll("[data-command-group]")];

  const openPalette = () => {
    if (!(commandRoot instanceof HTMLElement) || !(commandInput instanceof HTMLInputElement)) return;
    commandRoot.classList.remove("hidden");
    commandInput.value = "";
    commandItems.forEach((item) => item.classList.remove("hidden"));
    commandGroups.forEach((group) => group.classList.remove("hidden"));
    requestAnimationFrame(() => commandInput.focus());
  };

  const closePalette = () => {
    if (!(commandRoot instanceof HTMLElement)) return;
    commandRoot.classList.add("hidden");
  };

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openPalette();
    }

    if (event.key === "Escape") {
      closePalette();
    }
  });

  commandOverlay?.addEventListener("click", closePalette);
  commandInput?.addEventListener("input", () => {
    if (!(commandInput instanceof HTMLInputElement)) return;
    const query = commandInput.value.trim().toLowerCase();

    commandItems.forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      const haystack = item.dataset.commandSearch ?? item.textContent?.trim().toLowerCase() ?? "";
      item.classList.toggle("hidden", query.length > 0 && !haystack.includes(query));
    });

    commandGroups.forEach((group) => {
      if (!(group instanceof HTMLElement)) return;
      const visibleItems = group.querySelectorAll("[data-command-item]:not(.hidden)");
      group.classList.toggle("hidden", visibleItems.length === 0);
    });
  });
</script>
