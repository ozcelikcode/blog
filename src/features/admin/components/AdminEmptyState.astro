---
interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
---

<div class="admin-panel text-center">
  <h2 class="font-serif text-3xl italic tracking-tight">{title}</h2>
  <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-[color:var(--page-muted)]">{description}</p>
</div>
