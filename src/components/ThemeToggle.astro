<button
  class="inline-flex h-10 items-center justify-center rounded-full border px-4 text-sm font-medium transition-colors hover:border-[var(--page-accent)] hover:text-[var(--page-accent)]"
  data-theme-toggle
  type="button"
>
  Theme
</button>

<script>
  type ThemeController = {
    applyTheme: (theme: "dark" | "light") => void;
    media: MediaQueryList;
    resolveTheme: () => "dark" | "light";
    storageKey: string;
  };

  const themeWindow = window as Window & {
    __developerBlogTheme?: ThemeController;
  };

  const root = document.documentElement;

  const updateThemeButtons = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      const isDark = root.dataset.theme === "dark";
      button.textContent = isDark ? "Light mode" : "Dark mode";
      button.setAttribute("aria-pressed", String(isDark));
    });
  };

  const controller = themeWindow.__developerBlogTheme;

  if (controller && root.dataset.themeToggleReady !== "true") {
    document.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>("[data-theme-toggle]");

      if (!button) {
        return;
      }

      const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
      localStorage.setItem(controller.storageKey, nextTheme);
      controller.applyTheme(nextTheme);
    });

    controller.media.addEventListener("change", (event) => {
      if (localStorage.getItem(controller.storageKey)) {
        return;
      }

      controller.applyTheme(event.matches ? "dark" : "light");
    });

    document.addEventListener("developer-blog-theme-change", updateThemeButtons);
    root.dataset.themeToggleReady = "true";
  }

  updateThemeButtons();
</script>
