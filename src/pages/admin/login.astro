---
import { actions } from "astro:actions";

import BaseHead from "@/components/BaseHead.astro";
import ThemeScript from "@/components/ThemeScript.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getSiteSettings } from "@/features/blog/repositories/site-repository";
import { buildPageSeoMetadata } from "@/lib/seo/metadata";
import "@/styles/global.css";

const actionResult = Astro.getActionResult(actions.admin.login);
if (actionResult?.data?.ok && actionResult.data.redirectTo) {
  return Astro.redirect(actionResult.data.redirectTo);
}

const settings = getSiteSettings();
const metadata = buildPageSeoMetadata({
  description: "Sign in to manage the publication.",
  pathname: Astro.url.pathname,
  settings,
  title: "Admin Login",
});
const next = Astro.url.searchParams.get("next") ?? "/admin";
const loggedOut = Astro.url.searchParams.get("logged-out") === "1";
const formError =
  actionResult?.data && !actionResult.data.ok
    ? actionResult.data.formError
    : actionResult?.error?.message;
const values = actionResult?.data && !actionResult.data.ok ? actionResult.data.values : { email: "" };
---

<!doctype html>
<html class="admin-root" lang="en">
  <head>
    <BaseHead metadata={metadata} />
    <ThemeScript />
    <meta content="noindex, nofollow" name="robots" />
  </head>
  <body class="admin-shell">
    <main class="mx-auto flex min-h-screen w-full max-w-6xl items-center justify-center px-5 py-16">
      <div class="w-full">
        <div class="mb-5 flex justify-end">
          <ThemeToggle />
        </div>

        <div class="grid w-full gap-8 lg:grid-cols-[1fr_24rem]">
        <section class="admin-panel flex min-h-[32rem] flex-col justify-between">
          <div>
            <p class="eyebrow">Midnight Inkwell</p>
            <h1 class="mt-4 max-w-2xl font-serif text-6xl italic tracking-tight">Run the publication with calm, precise control.</h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-[color:var(--page-muted)]">
              The admin panel follows the same editorial direction as the public site, but the interaction model is tuned for operational work.
            </p>
          </div>

          <div class="grid gap-4 md:grid-cols-3">
            <div class="admin-panel">
              <p class="admin-label">Posts</p>
              <p class="font-serif text-3xl italic">Draft, schedule, publish.</p>
            </div>
            <div class="admin-panel">
              <p class="admin-label">Media</p>
              <p class="font-serif text-3xl italic">Upload once, reuse cleanly.</p>
            </div>
            <div class="admin-panel">
              <p class="admin-label">Audit</p>
              <p class="font-serif text-3xl italic">Track meaningful actions.</p>
            </div>
          </div>
        </section>

        <section class="admin-panel self-center">
          <p class="eyebrow">Admin Access</p>
          <h2 class="mt-3 font-serif text-4xl italic tracking-tight">Sign in</h2>
          <p class="mt-3 text-sm leading-7 text-[color:var(--page-muted)]">Use the seeded local admin account to enter the console.</p>

          {loggedOut && (
            <div class="mt-5 rounded-2xl border border-[color:var(--page-border)] px-4 py-3 text-sm text-[color:var(--page-muted)]">
              You have been signed out.
            </div>
          )}

          <form action={actions.admin.login} class="mt-8 space-y-5" method="post">
            <input name="next" type="hidden" value={next} />

            <label class="block">
              <span class="admin-label">Email</span>
              <input class="admin-input" name="email" type="email" value={values.email} />
            </label>

            <label class="block">
              <span class="admin-label">Password</span>
              <input class="admin-input" name="password" type="password" />
            </label>

            {formError && <div class="rounded-2xl border border-[color:color-mix(in_srgb,var(--admin-danger)_40%,transparent)] px-4 py-3 text-sm text-[color:var(--admin-danger)]">{formError}</div>}

            <button class="admin-button-primary w-full" type="submit">Sign In</button>
          </form>
        </section>
        </div>
      </div>
    </main>
  </body>
</html>
