---
import { actions } from "astro:actions";

import AdminEmptyState from "@/features/admin/components/AdminEmptyState.astro";
import AdminPaginationNav from "@/features/admin/components/AdminPaginationNav.astro";
import AdminPageHeader from "@/features/admin/components/AdminPageHeader.astro";
import AdminLayout from "@/features/admin/layouts/AdminLayout.astro";
import { getAdminMediaPageData } from "@/features/admin/media/services/admin-media-service";
import { parseAdminPageQuery } from "@/features/admin/utils/queries";
import { parseOptionalPositiveIntParam } from "@/lib/http/params";
import { formatRelativeAdminDate } from "@/lib/utils/dates";

function formatBytes(value: number): string {
  if (value < 1024) {
    return `${value} B`;
  }

  if (value < 1024 * 1024) {
    return `${(value / 1024).toFixed(1)} KB`;
  }

  return `${(value / (1024 * 1024)).toFixed(1)} MB`;
}

const uploadResult = Astro.getActionResult(actions.admin.media.upload);
if (uploadResult?.data?.ok && uploadResult.data.redirectTo) {
  return Astro.redirect(uploadResult.data.redirectTo);
}

const updateResult = Astro.getActionResult(actions.admin.media.update);
if (updateResult?.data?.ok && updateResult.data.redirectTo) {
  return Astro.redirect(updateResult.data.redirectTo);
}

const deleteResult = Astro.getActionResult(actions.admin.media.delete);
if (deleteResult?.data?.ok && deleteResult.data.redirectTo) {
  return Astro.redirect(deleteResult.data.redirectTo);
}

const page = parseAdminPageQuery(Astro.url.searchParams);
const query = Astro.url.searchParams.get("q") ?? "";
const selectedAssetId = parseOptionalPositiveIntParam(
  Astro.url.searchParams.get("asset") ??
    (updateResult?.data && !updateResult.data.ok ? updateResult.data.values.mediaAssetId : undefined) ??
    (deleteResult?.data && !deleteResult.data.ok
      ? Astro.url.searchParams.get("asset") ?? undefined
      : undefined),
);
const data = getAdminMediaPageData({
  assetId: selectedAssetId,
  page,
  query,
});
const uploadFormError =
  uploadResult?.data && !uploadResult.data.ok ? uploadResult.data.formError : uploadResult?.error?.message;
const updateFormError =
  updateResult?.data && !updateResult.data.ok ? updateResult.data.formError : updateResult?.error?.message;
const deleteFormError =
  deleteResult?.data && !deleteResult.data.ok ? deleteResult.data.formError : deleteResult?.error?.message;
const selectedAssetForm = data.selectedAsset
  ? {
      altText:
        updateResult?.data && !updateResult.data.ok
          ? updateResult.data.values.altText
          : data.selectedAsset.altText ?? "",
      mediaAssetId: String(data.selectedAsset.id),
    }
  : null;
---

<AdminLayout currentPath="/admin/media" description="Upload and manage images with minimal operational overhead." title="Media">
  <AdminPageHeader
    description="The media library stays intentionally narrow: upload, describe, inspect usage, and reuse."
    eyebrow="Assets"
    title="Media"
  />

  <div class="mb-8 grid gap-8 xl:grid-cols-[24rem_minmax(0,1fr)]">
    <section class="space-y-6">
      <div class="admin-panel">
        <p class="admin-label">Upload image</p>
        <h2 class="font-serif text-3xl italic">Add media</h2>
        <form action={actions.admin.media.upload} class="mt-6 space-y-5" enctype="multipart/form-data" method="post">
          <label class="block">
            <span class="admin-label">Image file</span>
            <input accept="image/gif,image/jpeg,image/png,image/svg+xml,image/webp" class="admin-input file:mr-4 file:rounded-full file:border-0 file:bg-[color:var(--page-accent)] file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white" name="file" type="file" />
            <p class="admin-help">Supports GIF, JPEG, PNG, SVG, and WEBP up to 5 MB.</p>
          </label>

          <label class="block">
            <span class="admin-label">Alt text</span>
            <textarea class="admin-textarea min-h-28" name="altText">{uploadResult?.data && !uploadResult.data.ok ? uploadResult.data.values.altText : ""}</textarea>
          </label>

          {uploadFormError && (
            <div class="rounded-2xl border border-[color:color-mix(in_srgb,var(--admin-danger)_40%,transparent)] px-4 py-3 text-sm text-[color:var(--admin-danger)]">
              {uploadFormError}
            </div>
          )}

          <button class="admin-button-primary w-full" type="submit">Upload</button>
        </form>
      </div>

      {data.selectedAsset && selectedAssetForm && (
        <div class="admin-panel">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="admin-label">Selected asset</p>
              <h2 class="font-serif text-3xl italic">{data.selectedAsset.fileName}</h2>
            </div>
            <button
              class="admin-button-secondary"
              data-copy-url={data.selectedAsset.publicUrl}
              onclick="navigator.clipboard.writeText(this.dataset.copyUrl || '')"
              type="button"
            >
              Copy URL
            </button>
          </div>

          <img alt={data.selectedAsset.altText ?? ""} class="mt-6 aspect-[4/3] w-full rounded-2xl border border-[color:var(--page-border)] object-cover" src={data.selectedAsset.publicUrl} />

          <dl class="mt-6 grid gap-3 text-sm text-[color:var(--page-muted)]">
            <div class="flex items-center justify-between gap-4">
              <dt>MIME type</dt>
              <dd>{data.selectedAsset.mimeType}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt>Size</dt>
              <dd>{formatBytes(data.selectedAsset.fileSizeBytes)}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt>Uploaded</dt>
              <dd>{formatRelativeAdminDate(data.selectedAsset.createdAt)}</dd>
            </div>
          </dl>

          <form action={actions.admin.media.update} class="mt-6 space-y-5" method="post">
            <input name="mediaAssetId" type="hidden" value={selectedAssetForm.mediaAssetId} />

            <label class="block">
              <span class="admin-label">Alt text</span>
              <textarea class="admin-textarea min-h-28" name="altText">{selectedAssetForm.altText}</textarea>
            </label>

            {updateFormError && (
              <div class="rounded-2xl border border-[color:color-mix(in_srgb,var(--admin-danger)_40%,transparent)] px-4 py-3 text-sm text-[color:var(--admin-danger)]">
                {updateFormError}
              </div>
            )}

            <button class="admin-button-primary w-full" type="submit">Save Details</button>
          </form>

          <div class="mt-6 rounded-2xl border border-[color:var(--page-border)] px-4 py-4">
            <p class="admin-label">Usage</p>
            {data.selectedAsset.usages.length > 0 ? (
              <ul class="space-y-2 text-sm">
                {data.selectedAsset.usages.map((usage) => (
                  <li>
                    <a class="hover:text-[color:var(--page-accent)]" href={`/admin/posts/${usage.postId}`}>{usage.postTitle}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-[color:var(--page-muted)]">This asset is not currently attached to a post cover.</p>
            )}
          </div>

          <form action={actions.admin.media.delete} class="mt-6" method="post" onsubmit="return confirm('Delete this media asset?');">
            <input name="mediaAssetId" type="hidden" value={data.selectedAsset.id} />
            <button class="admin-button-danger w-full" type="submit">Delete Asset</button>
          </form>

          {deleteFormError && (
            <div class="mt-5 rounded-2xl border border-[color:color-mix(in_srgb,var(--admin-danger)_40%,transparent)] px-4 py-3 text-sm text-[color:var(--admin-danger)]">
              {deleteFormError}
            </div>
          )}
        </div>
      )}
    </section>

    <section class="space-y-6">
      <form class="admin-panel grid gap-4 md:grid-cols-[minmax(0,1fr)_auto]" method="get">
        <label>
          <span class="admin-label">Search</span>
          <input class="admin-input" name="q" placeholder="Filename or alt text" value={data.query} />
        </label>
        <div class="flex items-end">
          <button class="admin-button-primary w-full" type="submit">Apply</button>
        </div>
      </form>

      {data.items.length > 0 ? (
        <>
          <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {data.items.map((asset) => (
              <a class="admin-panel block space-y-4" href={`/admin/media?asset=${asset.id}`}>
                <img alt={asset.altText ?? ""} class="aspect-[4/3] w-full rounded-2xl border border-[color:var(--page-border)] object-cover" src={asset.publicUrl} />
                <div>
                  <p class="truncate font-medium">{asset.fileName}</p>
                  <p class="mt-1 text-xs uppercase tracking-[0.18em] text-[color:var(--page-muted)]">
                    {asset.mimeType} | {formatBytes(asset.fileSizeBytes)}
                  </p>
                  <p class="mt-3 text-sm text-[color:var(--page-muted)]">{asset.altText || "No alt text"}</p>
                </div>
              </a>
            ))}
          </div>

          <AdminPaginationNav
            currentPage={page}
            pathname={Astro.url.pathname}
            searchParams={Astro.url.searchParams}
            totalItems={data.totalItems}
            totalPages={data.totalPages}
          />
        </>
      ) : (
        <AdminEmptyState description="No media assets matched the current filter." title="No media found" />
      )}
    </section>
  </div>
</AdminLayout>
