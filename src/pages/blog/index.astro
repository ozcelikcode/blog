---
import PaginationNav from "@/components/PaginationNav.astro";
import PostCard from "@/components/PostCard.astro";
import { getBlogIndexData } from "@/features/blog/services/post-service";
import { parsePageQuery } from "@/features/blog/validators/post-queries";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageSeoMetadata } from "@/lib/seo/metadata";

const page = parsePageQuery(Astro.url.searchParams);
const data = getBlogIndexData(page);

if (data.pagination.isOutOfRange) {
  Astro.response.status = 404;
}

const metadata = buildPageSeoMetadata({
  description: "All published posts, ordered with the latest writing first.",
  pathname: Astro.url.pathname,
  settings: data.settings,
  title: "Blog",
});
---

<BaseLayout metadata={metadata} settings={data.settings}>
  <section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
    <div class="max-w-3xl space-y-4">
      <p class="eyebrow">Archive</p>
      <h1 class="font-serif text-5xl tracking-tight">All posts</h1>
      <p class="text-lg leading-8 text-[color:var(--page-muted)]">
        Engineering notes on architecture, developer experience, and maintainable publishing
        systems.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8">
    {data.pagination.items.length > 0 ? (
      <div class="space-y-8">
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {data.pagination.items.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
        <PaginationNav
          pagination={data.pagination}
          pathname={Astro.url.pathname}
          searchParams={Astro.url.searchParams}
        />
      </div>
    ) : (
      <div class="surface-card max-w-3xl">
        <h2 class="font-serif text-3xl tracking-tight">No posts on this page</h2>
        <p class="mt-3 text-base leading-7 text-[color:var(--page-muted)]">
          Try the first page or use search to find a specific article.
        </p>
      </div>
    )}
  </section>
</BaseLayout>
