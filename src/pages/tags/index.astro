---
import TagPill from "@/components/TagPill.astro";
import { getTagsIndexData } from "@/features/blog/services/post-service";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageSeoMetadata } from "@/lib/seo/metadata";

const data = getTagsIndexData();

const metadata = buildPageSeoMetadata({
  description: "Browse all topics covered across published posts.",
  pathname: Astro.url.pathname,
  settings: data.settings,
  title: "Tags",
});
---

<BaseLayout metadata={metadata} settings={data.settings}>
  <section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
    <div class="max-w-3xl space-y-4">
      <p class="eyebrow">Topics</p>
      <h1 class="font-serif text-5xl tracking-tight">All tags</h1>
      <p class="text-lg leading-8 text-[color:var(--page-muted)]">
        {data.tags.length} {data.tags.length === 1 ? "topic" : "topics"} with published posts.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8">
    {data.tags.length > 0 ? (
      <div class="flex flex-wrap gap-3">
        {data.tags.map((tag) => (
          <TagPill href={`/tags/${tag.slug}`} label={`${tag.name} (${tag.postCount})`} />
        ))}
      </div>
    ) : (
      <div class="surface-card max-w-3xl">
        <h2 class="font-serif text-3xl tracking-tight">No tags yet</h2>
        <p class="mt-3 text-base leading-7 text-[color:var(--page-muted)]">
          Tags will appear here once posts are published with topics assigned.
        </p>
      </div>
    )}
  </section>
</BaseLayout>
