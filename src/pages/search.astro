---
import PaginationNav from "@/components/PaginationNav.astro";
import PostCard from "@/components/PostCard.astro";
import SearchForm from "@/components/SearchForm.astro";
import { getSearchPageData } from "@/features/blog/services/post-service";
import { parseSearchQuery } from "@/features/blog/validators/post-queries";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageSeoMetadata } from "@/lib/seo/metadata";

const { page, query } = parseSearchQuery(Astro.url.searchParams);
const data = getSearchPageData(query, page);

if (data.pagination.isOutOfRange) {
  Astro.response.status = 404;
}

const metadata = buildPageSeoMetadata({
  description: "Search across published posts by title, excerpt, and tag.",
  pathname: Astro.url.pathname,
  settings: data.settings,
  title: "Search",
});
---

<BaseLayout metadata={metadata} settings={data.settings}>
  <section class="mx-auto w-full max-w-4xl px-5 py-16 sm:px-8">
    <div class="mb-8 max-w-3xl space-y-4">
      <p class="eyebrow">Search</p>
      <h1 class="font-serif text-5xl tracking-tight">Find a post</h1>
      <p class="text-lg leading-8 text-[color:var(--page-muted)]">
        Search stays intentionally simple in v1 and looks across titles, excerpts, and tags.
      </p>
    </div>

    <SearchForm query={data.query} />
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8">
    {!data.query ? (
      <div class="surface-card max-w-3xl">
        <h2 class="font-serif text-3xl tracking-tight">Start with a keyword</h2>
        <p class="mt-3 text-base leading-7 text-[color:var(--page-muted)]">
          Try terms like <strong>Astro</strong>, <strong>SQLite</strong>, or
          <strong> testing</strong>.
        </p>
      </div>
    ) : data.pagination.items.length > 0 ? (
      <div class="space-y-8">
        <p class="text-sm text-[color:var(--page-muted)]">
          {data.pagination.totalItems} result{data.pagination.totalItems === 1 ? "" : "s"} for
          “{data.query}”
        </p>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {data.pagination.items.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
        <PaginationNav
          pagination={data.pagination}
          pathname={Astro.url.pathname}
          searchParams={Astro.url.searchParams}
        />
      </div>
    ) : (
      <div class="surface-card max-w-3xl">
        <h2 class="font-serif text-3xl tracking-tight">No results</h2>
        <p class="mt-3 text-base leading-7 text-[color:var(--page-muted)]">
          No published posts matched “{data.query}”. Try a broader keyword.
        </p>
      </div>
    )}
  </section>
</BaseLayout>
