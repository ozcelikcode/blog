{
  "name": "developer-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Astro blog powered by SQLite and Drizzle.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit --pretty false",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:health": "tsx scripts/check-db.ts",
    "db:studio": "drizzle-kit studio",
    "test:unit": "cross-env DATABASE_URL=./data/test.db NODE_ENV=test vitest run --coverage",
    "test:watch": "cross-env DATABASE_URL=./data/test.db NODE_ENV=test vitest",
    "test:e2e": "cross-env DATABASE_URL=./data/test.db NODE_ENV=test tsx scripts/seed-db.ts --reset && cross-env DATABASE_URL=./data/test.db NODE_ENV=test playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozcelikcode/blog.git"
  },
  "bugs": {
    "url": "https://github.com/ozcelikcode/blog/issues"
  },
  "homepage": "https://github.com/ozcelikcode/blog#readme",
  "license": "MIT",
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "@astrojs/rss": "^4.0.18",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.3",
    "better-sqlite3": "^12.8.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "marked": "^17.0.5",
    "sanitize-html": "^2.17.2",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@biomejs/biome": "^2.4.10",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
